APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

COREPANEL_NAME=CorePanel
COREPANEL_VERSION=0.0.0-dev
COREPANEL_INSTANCE_ID=
COREPANEL_INSTANCE_LABEL=
COREPANEL_INSTANCE_DOMAIN=
COREPANEL_ORG_API_URL=https://corepanel.org/api/v1
COREPANEL_ORG_HEALTH_URL=https://corepanel.org/up
# SSL: leave false in local (Windows/cURL CA issues). In prod set true and optionally a CA path with forward slashes.
COREPANEL_ORG_VERIFY_SSL=false
# COREPANEL_ORG_CA_BUNDLE=C:/tools/php85/extras/ssl/cacert.pem
COREPANEL_ORG_TIMEOUT_SECONDS=10
# Optional override of the built-in marketplace catalogue token (marketplace:read). Leave empty in production.
COREPANEL_ORG_API_TOKEN=
COREPANEL_MARKETPLACE_ENABLED=true
COREPANEL_MARKETPLACE_CACHE_ENABLED=true
COREPANEL_MARKETPLACE_CACHE_STORE=redis
COREPANEL_MARKETPLACE_CACHE_PREFIX=corepanel.marketplace
COREPANEL_MARKETPLACE_CACHE_TTL=3600
COREPANEL_LICENSE_GRACE_HOURS=72
COREPANEL_LICENSE_CACHE_HOURS=12

COREPANEL_LOGIN_MAX_ATTEMPTS=5
COREPANEL_LOGIN_DECAY_SECONDS=60
COREPANEL_REGISTRATION_MODE=invite
COREPANEL_REGISTRATION_DEFAULT_ROLE=client
COREPANEL_REGISTRATION_INVITATION_TTL=72
COREPANEL_PASSWORD_RESET_MAX_ATTEMPTS=5
COREPANEL_PASSWORD_RESET_DECAY_SECONDS=60
COREPANEL_PASSWORD_RESET_EXPIRE=60
COREPANEL_PASSWORD_RESET_THROTTLE=60
COREPANEL_EMAIL_VERIFICATION_REQUIRED=true
COREPANEL_EMAIL_VERIFICATION_EXPIRE=60
COREPANEL_EMAIL_VERIFICATION_MAX_ATTEMPTS=6
COREPANEL_EMAIL_VERIFICATION_DECAY_SECONDS=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions — Redis recommended (CDC Tome 4 §4.1). Fallback: SESSION_DRIVER=database
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_SESSION_DB=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
